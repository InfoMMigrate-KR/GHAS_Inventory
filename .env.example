# GitHub Enterprise Configuration
# Required: Your GitHub Enterprise slug (e.g., 'your-company')
GH_ENTERPRISE_SLUG=your-enterprise-slug

# GitHub App Authentication (REQUIRED for most scripts)
# Required: Your GitHub App ID (numeric ID from GitHub App settings)
GH_APP_ID=your-app-id

# Required: Path to your GitHub App's private key file
# Generate from GitHub App settings and save as .pem file
GH_PRIVATE_KEY=your-app-private-key.pem

# Optional: SSL verification (default: true)
# Set to 'false' only for testing with self-signed certificates
VERIFY_SSL=true

# Organizations List Configuration
# The scripts read organizations from a CSV file with a 'login' column
# Place the file at: organizations.csv or scripts/fetch_languages/output/organizations.csv
# You can generate this file using scripts/fetch_languages/fetch_orgs.py

# Performance and Reliability Configuration (Optional)
# Maximum retry attempts for failed requests (default: 3)
MAX_RETRIES=3

# Initial retry delay in seconds with exponential backoff (default: 2)
RETRY_DELAY=2

# Request timeout in seconds (default: 30)
TIMEOUT=30

# Maximum concurrent organization processing (default: 3)
# Conservative value recommended for GitHub App rate limits
MAX_CONCURRENT_ORGS=3

# Delay between API requests in seconds (default: 1.0)
# Helps prevent rate limiting issues
REQUEST_DELAY=1.0

# HTTP connection pool size (default: 10)
SESSION_POOL_SIZE=10

# Memory usage warning threshold in MB (default: 1000)
MEMORY_THRESHOLD_MB=1000

# Rate limit buffer - pause before hitting this many remaining requests (default: 100)
RATE_LIMIT_BUFFER=100

# Secret Scanning Configuration
# Optional: Alert state to fetch (default: open)
# Valid values: open, resolved, all
ALERT_STATE=open

# Optional: Custom output filename without extension (default: auto-generated with timestamp)
OUTPUT_FILENAME=secret_scanning_report

# Optional: Output format (default: xlsx)
# Valid values: xlsx, csv, both
OUTPUT_FORMAT=csv

# Optional: Enable commit information enrichment (default: true)
# Set to 'false' to disable commit information fetching and save API rate limits
# When enabled, adds Committer_Id column with GitHub handle of the user who committed the secret
ENABLE_COMMIT_ENRICHMENT=true

# Testing and Development Configuration
# Optional: Enable testing mode to fetch limited number of organizations (default: false)
# Useful for testing functionality without using too much API quota
TEST_MODE=false

# Optional: Number of organizations to process in test mode (default: 10)
# Only used when TEST_MODE=true
TEST_ORG_LIMIT=10

# Legacy Configuration (for backward compatibility with older scripts using PATs)
# Required: GitHub Personal Access Tokens (comma-separated for multiple tokens)
# Tokens should have 'read:enterprise' scope for accessing enterprise-level security alerts
# Format: ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GH_PATS=ghp_token1,ghp_token2,ghp_token3

# Optional: Input CSV path for legacy scripts
INPUT_CSV_PATH=organizations.csv

# Example Configuration:
# GH_ENTERPRISE_SLUG=mycompany
# GH_APP_ID=123456
# GH_PRIVATE_KEY=my-app-private-key.pem
# VERIFY_SSL=true
# MAX_RETRIES=3
# TIMEOUT=60
# MAX_CONCURRENT_ORGS=5
# REQUEST_DELAY=0.5
# ALERT_STATE=open
# OUTPUT_FILENAME=security_report_2024
# OUTPUT_FORMAT=both
# ENABLE_COMMIT_ENRICHMENT=true
# TEST_MODE=false
# TEST_ORG_LIMIT=5
# Legacy PAT tokens (if still needed):
# GH_PATS=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx,ghp_yyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyy
